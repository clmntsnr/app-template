    "@tanstack/react-query-devtools": "catalog:tanstack",
    "@tanstack/react-db": "catalog:tanstack",
    "@tanstack/db": "catalog:tanstack",
    "@tanstack/query-db-collection": "catalog:tanstack",
    "@tanstack/react-form": "catalog:tanstack",
    "@package-ui/shadcn": "workspace:*",
    "@capacitor/core": "catalog:native",
    "@capacitor/ios": "catalog:native",
    "@capacitor/android": "catalog:native",
    "date-fns": "^4.1.0",
    "recharts": "2.15.4",
    "lucide-react": "catalog:icons"
  },
  "devDependencies": {
    "@package-config/typescript": "workspace:*",

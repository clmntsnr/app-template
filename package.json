{
  "name": "app-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "turbo": "2.9.12",
    "typescript": "^6.0.3",
    "bun-types": "catalog:build"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*/*"
    ],
    "catalogs": {
      "react": {
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3"
      },
      "tanstack": {
        "@tanstack/react-router": "1.169.2",
        "@tanstack/react-start": "1.167.65",
        "@tanstack/react-query": "5.100.9",
        "@tanstack/react-table": "9.0.0-alpha.45",
        "@tanstack/react-form": "1.30.0",
        "@tanstack/react-virtual": "3.13.24",
        "@tanstack/pacer": "0.21.0",
        "@tanstack/router-plugin": "1.167.35"
      },
      "backend": {
        "elysia": "1.4.28",
        "@elysiajs/eden": "1.4.9",
        "effect": "4.0.0-beta.64"
      },
      "database": {
        "drizzle-orm": "1.0.0-rc.2",
        "drizzle-kit": "1.0.0-rc.2",
        "drizzle-typebox": "1.0.0-beta.14-a36c63d",
        "postgres": "3.4.9",
        "better-auth": "1.6.10"
      },
      "build": {
        "vite": "8.0.11",
        "@vitejs/plugin-react": "6.0.1",
        "typescript": "6.0.3",
        "bun-types": "1.3.13",
        "@sinclair/typebox": "0.34.49"
      },
      "styling": {
        "tailwindcss": "4.3.0",
        "@tailwindcss/vite": "4.3.0",
        "tw-animate-css": "1.4.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "tailwind-merge": "3.5.0"
      },
      "icons": {
        "lucide-react": "1.14.0"
      }
    }
  }
}
